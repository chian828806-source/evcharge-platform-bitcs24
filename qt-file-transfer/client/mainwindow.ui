 <widget class="QMainWindow" name="MainWindow">
  <property name="minimumSize"><size><width>760</width><height>580</height></size></property>
  <property name="windowTitle"><string>Qt 文件传输客户端</string></property>
  <widget class="QWidget" name="central">
   <layout class="QVBoxLayout" name="mainLayout">
    <property name="leftMargin"><number>24</number></property><property name="topMargin"><number>22</number></property><property name="rightMargin"><number>24</number></property><property name="bottomMargin"><number>22</number></property><property name="spacing"><number>14</number></property>
    <item><layout class="QVBoxLayout" name="titleLayout"><property name="spacing"><number>2</number></property><item><widget class="QLabel" name="titleLabel"><property name="text"><string>文件传输客户端</string></property></widget></item><item><widget class="QLabel" name="subtitleLabel"><property name="text"><string>连接到服务端，选择文件或拖入文件开始发送</string></property></widget></item></layout></item>
    <item><widget class="QGroupBox" name="connectionGroup"><property name="title"><string>连接目标</string></property><layout class="QGridLayout" name="connectionLayout"><item row="0" column="0"><widget class="QLabel" name="hostLabel"><property name="text"><string>服务器地址</string></property></widget></item><item row="0" column="1"><widget class="QLineEdit" name="hostEdit"><property name="minimumHeight"><number>34</number></property><property name="placeholderText"><string>例如 127.0.0.1</string></property><property name="text"><string>127.0.0.1</string></property></widget></item><item row="0" column="2"><widget class="QLabel" name="portLabel"><property name="text"><string>端口</string></property></widget></item><item row="0" column="3"><widget class="QSpinBox" name="portSpin"><property name="minimumHeight"><number>34</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>19000</number></property></widget></item><item row="0" column="4"><widget class="QPushButton" name="connectButton"><property name="minimumHeight"><number>34</number></property><property name="text"><string>连接</string></property></widget></item><item row="1" column="0" colspan="4"><widget class="QLabel" name="connectionStateLabel"><property name="text"><string>● 未连接</string></property></widget></item><item row="1" column="4"><widget class="QPushButton" name="chooseButton"><property name="minimumHeight"><number>34</number></property><property name="text"><string>选择文件</string></property></widget></item></layout></widget></item>
    <item><widget class="DropZone" name="dropZone"><property name="minimumSize"><size><width>0</width><height>170</height></size></property><property name="text"><string>拖入文件即可发送</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
    <item><widget class="QGroupBox" name="transferGroup"><property name="title"><string>当前传输</string></property><layout class="QVBoxLayout" name="transferLayout"><item><widget class="QLabel" name="transferStateLabel"><property name="text"><string>等待发送文件</string></property></widget></item><item><widget class="QProgressBar" name="progressBar"><property name="value"><number>0</number></property><property name="textVisible"><bool>true</bool></property></widget></item></layout></widget></item>
    <item><widget class="QGroupBox" name="logGroup"><property name="title"><string>传输日志</string></property><layout class="QVBoxLayout" name="logLayout"><item><widget class="QTextEdit" name="logEdit"><property name="minimumSize"><size><width>0</width><height>100</height></size></property><property name="readOnly"><bool>true</bool></property><property name="placeholderText"><string>连接和传输状态会显示在这里</string></property></widget></item></layout></widget></item>
   </layout>
  </widget>
