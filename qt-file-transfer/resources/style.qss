QMainWindow,QDialog { background:#f4f7fb; }
QPushButton { background:#2563eb; color:white; border:0; border-radius:6px; padding:8px 14px; }
QPushButton:hover { background:#1d4ed8; }
QTextEdit { background:white; border:1px solid #cbd5e1; border-radius:6px; }
QProgressBar { border:1px solid #cbd5e1; border-radius:5px; background:white; text-align:center; }
QProgressBar::chunk { background:#22c55e; border-radius:4px; }
#dropZone { border:2px dashed #94a3b8; border-radius:10px; background:#eef2ff; }
#dropZone[dragging="true"] { border-color:#2563eb; background:#dbeafe; }
